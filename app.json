{
  "expo": {
    "name": "introvirght",
    "slug": "introvirght",
    "version": "1.0.0",
    "scheme": "introvirght",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCFBF8",
    "primaryColor": "#1A1815",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.introvirght.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Used to unlock your diary."
      }
    },
    "android": {
      "package": "com.introvirght.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4ED",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FCFBF8"
        }
      ],
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Used to unlock your diary."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground.png",
          "color": "#1A1815"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "b9bb1e4a-2917-46b1-8997-a55fbb2c785c"
      },
      "apiBaseUrl": "https://introvirght-server-production.up.railway.app",
      "googleClientIdAndroid": "88245092701-aoec6sogr65m089le93cv9tpmjegbdel.apps.googleusercontent.com",
      "googleClientIdIos": "",
      "googleClientIdWeb": "88245092701-knca4j5qlg0d5a1iuolb0h67fm2m52re.apps.googleusercontent.com"
    },
    "owner": "failedpupil"
  }
}
